<?xml version="1.0" encoding="utf-8"?>
<project>
	<app title="HaxeFlixel Dynamic Runtime" file="HaxeFlixelRuntime" main="Main" version="1.0.0" path="export" company="Custom" />
	
	<window width="1280" height="720" fps="60" background="0x000000" hardware="true" vsync="true" />

	<source path="source" />

	<haxelib name="flixel" />
	<haxelib name="flixel-addons" optional="true" />
	<haxelib name="flixel-ui" optional="true" />
	<haxelib name="sscript" />

	<assets path="assets" />

	<!-- Mantém todas as classes do Flixel e OpenFL salvas no executável -->
	<haxeflag name="--macro" value="keep('flixel')" />
	<haxeflag name="--macro" value="keep('openfl')" />
</project>
